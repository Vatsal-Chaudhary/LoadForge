# Build stage
FROM golang:1.26.3-alpine AS builder

RUN apk add --no-cache git make protoc

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

# Run make proto (if needed) and build the binary
RUN PATH=$PATH:$(go env GOPATH)/bin go build -ldflags="-w -s" -o bin/orchestrator ./cmd/orchestrator

# Run stage
FROM alpine:3.19

RUN apk add --no-cache ca-certificates

WORKDIR /app
COPY --from=builder /app/bin/orchestrator /app/orchestrator

EXPOSE 50051

ENTRYPOINT ["/app/orchestrator"]
