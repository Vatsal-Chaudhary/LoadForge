{
  "annotations": {
    "list": []
  },
  "description": "Application-under-test signals derived only from aggregator metrics currently exposed by LoadForge.",
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "RPS over time",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(loadforge_request_total{run_id=~\"$run_id\"}[$__rate_interval]))",
          "legendFormat": "RPS"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Latency Percentiles over time",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(loadforge_request_duration_ms_bucket{run_id=~\"$run_id\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(loadforge_request_duration_ms_bucket{run_id=~\"$run_id\"}[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(loadforge_request_duration_ms_bucket{run_id=~\"$run_id\"}[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Error Rate over time",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(loadforge_request_total{run_id=~\"$run_id\",status_code=~\"4..|5..\"}[$__rate_interval])) / clamp_min(sum(rate(loadforge_request_total{run_id=~\"$run_id\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "error rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.01
              }
            ]
          }
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Status Code Distribution over time",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "options": {
        "stacking": {
          "mode": "normal",
          "group": "A"
        },
        "drawStyle": "bars"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(loadforge_request_total{run_id=~\"$run_id\",status_code=~\"2..\"}[$__rate_interval]))",
          "legendFormat": "2xx"
        },
        {
          "refId": "B",
          "expr": "sum(rate(loadforge_request_total{run_id=~\"$run_id\",status_code=~\"4..\"}[$__rate_interval]))",
          "legendFormat": "4xx"
        },
        {
          "refId": "C",
          "expr": "sum(rate(loadforge_request_total{run_id=~\"$run_id\",status_code=~\"5..\"}[$__rate_interval]))",
          "legendFormat": "5xx"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Per-Endpoint Breakdown",
      "gridPos": {
        "h": 9,
        "w": 18,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "instant": true,
          "expr": "sum by (endpoint, method) (rate(loadforge_request_total{run_id=~\"$run_id\"}[$__rate_interval]))",
          "legendFormat": "RPS"
        },
        {
          "refId": "B",
          "format": "table",
          "instant": true,
          "expr": "histogram_quantile(0.95, sum by (endpoint, le) (rate(loadforge_request_duration_ms_bucket{run_id=~\"$run_id\"}[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "format": "table",
          "instant": true,
          "expr": "sum by (endpoint, method) (rate(loadforge_request_total{run_id=~\"$run_id\",status_code=~\"4..|5..\"}[$__rate_interval]))",
          "legendFormat": "errors"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "endpoint",
            "mode": "outer"
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      }
    },
    {
      "id": 6,
      "type": "text",
      "title": "Bytes Received/sec",
      "gridPos": {
        "h": 9,
        "w": 6,
        "x": 18,
        "y": 16
      },
      "options": {
        "mode": "markdown",
        "content": "### Metric gap\nWorkers include `bytes_recv` in NATS samples, but aggregator exposition currently discards it and exports no byte counter. This panel is intentionally query-free until that real metric exists."
      }
    }
  ],
  "schemaVersion": 39,
  "tags": [
    "loadforge",
    "application"
  ],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      },
      {
        "name": "run_id",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(loadforge_request_total, run_id)"
        },
        "includeAll": true,
        "allValue": ".*"
      }
    ]
  },
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "title": "LoadForge / Application Under Test",
  "uid": "loadforge-application",
  "version": 1
}
